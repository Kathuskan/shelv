PORT=5001
# Atlas or replica set required; stand-alone MongoDB cannot transact orders.
MONGO_URI=mongodb://127.0.0.1:27017/shelv?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
# Optional Google sign-in; configure the callback URL shown in README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use test keys and a verified webhook before enabling cards.
CARD_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
